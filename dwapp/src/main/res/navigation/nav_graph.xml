<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.discountworld.dwapp.fragments.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/nav_signup" />
        <action
            android:id="@+id/action_loginFragment_to_forgetPasswordFragment"
            app:destination="@id/nav_forget_password" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/nav_home" />
    </fragment>

    <fragment
        android:id="@+id/nav_signup"
        android:name="com.discountworld.dwapp.fragments.SignupFragment"
        android:label="SignupFragment"
        tools:layout="@layout/fragment_signup" />

    <fragment
        android:id="@+id/nav_forget_password"
        android:name="com.discountworld.dwapp.fragments.ForgetPasswordFragment"
        android:label="ForgetPasswordFragment"
        tools:layout="@layout/fragment_forget_password" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.discountworld.dwapp.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_nav_home_to_nav_profile"
            app:destination="@id/nav_profile" />
        <action
            android:id="@+id/action_nav_home_to_nav_delivery"
            app:destination="@id/nav_delivery" />
    </fragment>

    <fragment
        android:id="@+id/nav_locations"
        android:name="com.discountworld.dwapp.fragments.LocationsFragment"
        android:label="LocationsFragment"
        tools:layout="@layout/fragment_locations" />

    <fragment
        android:id="@+id/nav_promos"
        android:name="com.discountworld.dwapp.fragments.PromosFragment"
        android:label="PromosFragment"
        tools:layout="@layout/fragment_promos" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.discountworld.dwapp.fragments.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/nav_delivery"
        android:name="com.discountworld.dwapp.fragments.DeliveryFragment"
        android:label="DeliveryFragment"
        tools:layout="@layout/fragment_delivery">
        <argument
            android:name="showSearch"
            android:defaultValue="true"
            app:argType="boolean" />
        <argument
            android:name="hideBottomNav"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="categoryName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="categoryId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="searchQuery"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_history"
        android:name="com.discountworld.dwapp.fragments.HistoryFragment"
        android:label="HistoryFragment"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/nav_brand_detail"
        android:name="com.discountworld.dwapp.fragments.BrandDetailFragment"
        android:label="BrandDetailFragment"
        tools:layout="@layout/fragment_brand_detail">
        <action
            android:id="@+id/action_nav_brand_detail_to_nav_brand_info"
            app:destination="@id/nav_brand_info" />
    </fragment>

    <fragment
        android:id="@+id/nav_brand_info"
        android:name="com.discountworld.dwapp.fragments.BrandInfoFragment"
        android:label="BrandInfoFragment"
        tools:layout="@layout/fragment_brand_info">
        <argument
            android:name="vendor_id"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="city_id"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

</navigation>