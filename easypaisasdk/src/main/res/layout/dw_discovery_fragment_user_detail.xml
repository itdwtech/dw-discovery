<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dw_discovery_dim_gray"
    android:backgroundTint="@color/dw_discovery_dim_gray"
    tools:context=".fragments.UserDetailFragment">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dw_discovery_image_bg"
        android:contentDescription="@string/dw_discovery_back"
        android:src="@drawable/dw_discovery_ic_backs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <com.discountworld.easypaisasdk.reusables.TextViewBold
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="@string/dw_discovery_tim_hortons"
        android:textColor="@color/dw_discovery_black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Banner Image -->
            <ImageView
                android:id="@+id/bannerImage"
                android:layout_width="0dp"
                android:layout_height="198dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/dw_discovery_banner_image_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/dw_discovery_banner"
                android:src="@drawable/dw_discovery_ic_banner"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="NotSibling" />

            <!-- Offer Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/offerCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardBackgroundColor="@color/dw_discovery_white"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/dw_discovery_d_gray"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/bannerImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@color/dw_discovery_white">

                    <!-- Offer Title -->
                    <com.discountworld.easypaisasdk.reusables.TextViewBold
                        android:id="@+id/offerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/dw_discovery_black"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Offer Description -->
                    <com.discountworld.easypaisasdk.reusables.TextViewRegular
                        android:id="@+id/offerDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="6dp"
                        android:textSize="14sp"
                        android:textColor="@color/dw_discovery_black"
                        android:layout_marginStart="10dp"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintTop_toBottomOf="@id/offerTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Outlet pill -->
                    <com.discountworld.easypaisasdk.reusables.TextViewMedium
                        android:id="@+id/outletCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/dw_discovery_bg_outlet_pill"
                        android:layout_marginStart="10dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:layout_constraintTop_toBottomOf="@id/offerDesc"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Discounts on Cards Title -->
            <com.discountworld.easypaisasdk.reusables.TextViewBold
                android:id="@+id/tv_discount_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discounts on Cards"
                android:textColor="@color/dw_discovery_black"
                android:textSize="18sp"
                android:layout_marginTop="10sp"
                android:layout_marginStart="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/offerCard" />

            <!-- Card RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCards"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_discount_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/dw_discovery_item_card" />

            <!-- Outlets Title -->
            <com.discountworld.easypaisasdk.reusables.TextViewBold
                android:id="@+id/tv_outlets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outlets"
                android:textColor="@color/dw_discovery_black"
                android:textSize="18sp"
                android:layout_marginTop="15sp"
                android:layout_marginStart="14sp"
                app:layout_constraintStart_toStartOf="@id/rvCards"
                app:layout_constraintTop_toBottomOf="@id/rvCards" />

            <!-- Outlets RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOutlets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="20dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_outlets"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/dw_discovery_item_outlets" />

            <!-- Terms Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTerms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Read Terms and Conditions"
                android:textSize="14sp"
                android:textColor="@color/dw_discovery_black"
                android:backgroundTint="@android:color/transparent"
                app:cornerRadius="24dp"
                app:strokeColor="@color/dw_discovery_green"
                app:strokeWidth="1dp"
                android:layout_marginHorizontal="20sp"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/rvOutlets"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- FULL SCREEN LOADER -->
    <FrameLayout
        android:id="@+id/loaderLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/dw_discovery_green" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>