<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="title" type="String" />
        <variable name="subtitle" type="String" />
        <variable name="imageUrl" type="String" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/dw_discovery_white"
        app:strokeColor="@color/dw_discovery_dim_gray"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/dw_discovery_ic_banner"
                app:dw_discovery_imageUrl="@{imageUrl}" />

            <LinearLayout
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.discountworld.easypaisasdk.reusables.TextViewBold
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{title}"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:textColor="@color/dw_discovery_black"
                    android:textSize="16sp"/>

                <com.discountworld.easypaisasdk.reusables.TextViewMedium
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{subtitle}"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="end"
                    android:textColor="@color/dw_discovery_black"
                    android:maxLines="2"
                    android:textSize="12sp"/>

                <com.discountworld.easypaisasdk.reusables.TextViewRegular
                    android:id="@+id/txtTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dw_discovery_terms_applied"
                    android:textColor="@color/dw_discovery_green"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>
