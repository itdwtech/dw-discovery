<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.discountworld.easypaisasdk.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_userDetailFragment"
            app:destination="@id/userDetailFragment" />

        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />

    </fragment>

    <!-- User Detail Fragment -->
    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.discountworld.easypaisasdk.fragments.UserDetailFragment"
        android:label="UserDetailFragment"
        tools:layout="@layout/fragment_user_detail">

        <argument
            android:name="bannerTitle"
            app:argType="string" />

        <argument
            android:name="bannerSubtitle"
            app:argType="string" />

        <argument
            android:name="bannerTerms"
            app:argType="string" />

        <argument
            android:name="vendorId"
            app:argType="long" />

        <action
            android:id="@+id/action_userDetailFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.discountworld.easypaisasdk.fragments.SearchFragment"
        android:label="UserDetailFragment"
        tools:layout="@layout/fragment_search">

        <argument
            android:name="categoryId"
            app:argType="long" />

        <action
            android:id="@+id/action_searchFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_homeFragment_to_userDetailFragment"
            app:destination="@id/userDetailFragment" />

    </fragment>

</navigation>