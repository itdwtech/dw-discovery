<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="DwDiscovery.AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Make status bar white -->
        <item name="android:statusBarColor">@android:color/white</item>
        <!-- Make status bar icons dark (so they are visible on white) -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DwDiscovery.CenterDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="DwDiscovery.TermsText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/dw_discovery_text_black</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="DwDiscovery.RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


</resources>