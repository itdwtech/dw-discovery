<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discount World Prototype"
            android:textColor="#1A1C3D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CNIC:"
            android:textColor="#1A1C3D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProtoCnic"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background"
            android:digits="0123456789-"
            android:hint="e.g. 42301-8245417-1"
            android:inputType="phone"
            android:maxLength="15"
            android:paddingHorizontal="12dp"
            android:text=""
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDwApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Launch DW App"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Open EasyPaisa Discovery SDK"
            android:textSize="16sp"
            android:visibility="gone"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>